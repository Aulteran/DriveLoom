# Copy to deploy/.env (never commit it). Every value here is a secret or a site setting.

# The URL people type, with https and no trailing slash. Cookies, CSRF origin checks,
# passkeys and the identity-provider callback all derive from it.
DRIVELOOM_PUBLIC_ORIGIN=https://fuel.example.com

# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
DRIVELOOM_SECRET_KEY=

# Database password, e.g. `openssl rand -hex 24`. Use letters and digits only: it is placed in a URL.
POSTGRES_PASSWORD=

# Required to create the first (administrator) account while the instance is reachable
# by others. At least 16 characters. Remove it after setup if you like.
DRIVELOOM_SETUP_TOKEN=

# closed (default): new accounts need an invitation from an administrator. open: anyone can register.
DRIVELOOM_REGISTRATION=closed

# Addresses of reverse proxies whose X-Forwarded-For is believed (comma-separated IPs or CIDRs).
# With the proxy on the Docker host, this is usually the compose network's gateway, e.g. 172.16.0.0/12.
DRIVELOOM_TRUSTED_PROXIES=

# Host port on 127.0.0.1 that the proxy forwards to.
DRIVELOOM_PORT=8080

# Optional email for verification and password recovery.
DRIVELOOM_SMTP_URL=
DRIVELOOM_SMTP_FROM=
DRIVELOOM_REQUIRE_EMAIL_VERIFICATION=0
# 1: after a correct password, email a one-time code (accounts with an authenticator app use that instead).
DRIVELOOM_EMAIL_SIGN_IN_CODES=0

# Optional OpenID Connect sign-in. Register redirect URI <public origin>/v1/auth/oidc/callback.
DRIVELOOM_OIDC_ISSUER=
DRIVELOOM_OIDC_CLIENT_ID=
DRIVELOOM_OIDC_CLIENT_SECRET=
# Set to 0 to allow only OIDC (and passkeys) once OIDC is configured.
DRIVELOOM_PASSWORD_LOGIN=1
